{% comment %}Formats a whole-dollar amount with thousands separators (Liquid has no number formatting filter).{% endcomment %}{% assign n = include.n | plus: 0 %}{% assign ones = n | modulo: 1000 | prepend: '00' | slice: -3, 3 %}{% assign thou = n | divided_by: 1000 | modulo: 1000 %}{% assign mill = n | divided_by: 1000000 %}{% if mill > 0 %}{% assign thou_p = thou | prepend: '00' | slice: -3, 3 %}{{ mill }},{{ thou_p }},{{ ones }}{% elsif thou > 0 %}{{ thou }},{{ ones }}{% else %}{{ n }}{% endif %}